# Copie para .env.local quando rodar na sua maquina.
# No Vercel, cadastre os mesmos nomes em Settings > Environment Variables.

# A senha que abre a pagina. So voce precisa saber.
APP_PASSWORD=troque-esta-senha

# Uma string aleatoria e longa, usada para assinar o cookie de sessao.
# Gere uma com: openssl rand -hex 32
AUTH_SECRET=troque-por-uma-string-aleatoria-longa

# Aparece sozinha quando voce cria o banco Postgres no painel do Vercel
# (Storage > Create Database > Postgres) e conecta ao projeto.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Opcional. Se definida, o Vercel envia este valor no cabecalho do cron
# e a rota /api/cron recusa chamadas de fora.
CRON_SECRET=
